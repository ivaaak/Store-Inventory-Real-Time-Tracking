# --- Core ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Local Postgres (e.g. `docker compose up -d postgres`)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/shelf_monitoring?schema=public"
# Comma-separated list of dashboard origins allowed to call the API
CORS_ORIGIN=http://localhost:3001
# Requests per IP per 15 minutes on /api
RATE_LIMIT_MAX=2000

# --- Vision AI ---
# Set OPENAI_API_KEY to use OpenAI, or VISION_PROVIDER=mock for fake counts in development.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
VISION_PROVIDER=
UPLOAD_DIR=uploads

# --- POS webhook ---
# HMAC-SHA256 secret; required in production, optional in development.
POS_WEBHOOK_SECRET=

# --- Notifications (each channel is skipped when unset) ---
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_NUMBER=
SENDGRID_API_KEY=
EMAIL_FROM=
ALERT_EMAIL_TO=
